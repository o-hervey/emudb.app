# Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable key (found in Supabase dashboard → Settings → API)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase database connection string — transaction mode pooler (for runtime queries)
DATABASE_URL=

# Supabase database connection string — session mode pooler (for migrations)
DIRECT_URL=

# IGDB (Twitch Developer) credentials — used for system/console logos on the Systems page
# Register at https://dev.twitch.tv/console → Register Your Application
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Upstash Redis — required for production rate limiting (https://console.upstash.com)
# Without these, rate limiting falls back to in-process memory (not safe for serverless)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# IndexNow — API key generated in Bing Webmaster Tools (https://www.bing.com/webmasters)
# Also create public/<key>.txt containing just the key string for ownership verification
INDEXNOW_KEY=