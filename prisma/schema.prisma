generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Enums
enum Category {
  EMULATOR
  FRONTEND
  OPERATING_SYSTEM
  COMPATIBILITY_LAYER
  ROM_MANAGER
  MEDIA_SCRAPER
  GAME_STATE_TOOL
  STREAMING
  NETPLAY
  INPUT_CONTROLLERS
  SHADER
  COMPANION_APP
  UTILITY
}

enum SoftwareStatus {
  ACTIVE
  ABANDONED
  DEPRECATED
}

enum SystemType {
  HOME
  HANDHELD
  ARCADE
  COMPUTER
  OTHER
}

enum PlatformGroup {
  WINDOWS
  MACOS
  LINUX
  MOBILE
  CONSOLE
  OTHER
}

enum HardwareType {
  HANDHELD
  SBC
  MODDED_CONSOLE
  DESKTOP_ARCHITECTURE
  FPGA
}

enum SubmissionType {
  NEW_LISTING
  EDIT
  NEW_HARDWARE
  NEW_TAG
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ReportTargetType {
  LISTING
  EDIT
  RATING
  COMMENT
  TAG
}

enum ReportStatus {
  PENDING
  UPHELD
  DISMISSED
}

// Profiles table pattern: extends Supabase `auth.users` (do NOT store passwords here)
model Profile {
  id                String   @id @map("id") @db.Uuid
  username          String?  @unique
  isActive          Boolean  @default(true) @map("is_active")
  isModerator       Boolean  @default(false) @map("is_moderator")
  isSuperAdmin      Boolean  @default(false) @map("is_super_admin")
  reportCredibility Float    @default(1.0) @map("report_credibility")
  reportsFiledToday Int      @default(0) @map("reports_filed_today")
  complaintScore    Float    @default(0.0) @map("complaint_score")
  createdAt         DateTime @default(now()) @map("created_at")

  submittedSoftware    Software[]
  submissions          Submission[]
  qualityRatings       QualityRating[]
  performanceRatings   PerformanceRating[]
  reportsFiled         Report[]            @relation("reports_reporter")
  reportsReceived      Report[]            @relation("reports_target")
  submittedTags     Tag[]          @relation("tag_submitted_by")
  reviewedTags      Tag[]          @relation("tag_reviewed_by")
  ownedLists        UserList[]     @relation("owned_lists")
  savedLists        UserListSave[] @relation("saved_lists")

  @@map("profiles")
}

model Software {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  description String?
  category    Category
  approved    Boolean        @default(false)
  websiteUrl  String?        @map("website_url")
  downloadUrl String?        @map("download_url")
  sourceUrl   String?        @map("source_url")
  status      SoftwareStatus @default(ACTIVE)
  avgQuality  Float?         @map("avg_quality")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @default(now()) @updatedAt @map("updated_at")

  submittedBy String?  @map("submitted_by") @db.Uuid
  submitter   Profile? @relation(fields: [submittedBy], references: [id])

  systems             SoftwareSystem[]
  platforms           SoftwarePlatform[]
  hardware            SoftwareHardware[]
  tags                SoftwareTag[]
  qualityRatings      QualityRating[]
  performanceRatings  PerformanceRating[]
  listEntries         UserListEntry[]

  @@index([approved, category])
  @@index([approved, status])
  @@index([createdAt])
  @@index([approved, avgQuality])
  @@map("software")
}

model System {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String
  manufacturer String?
  type         SystemType

  software SoftwareSystem[]

  @@index([type])
  @@map("systems")
}

model Platform {
  id    String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name  String
  group PlatformGroup

  software        SoftwarePlatform[]
  primaryHardware Hardware[]
  hardware        HardwarePlatform[]

  @@index([group])
  @@map("platforms")
}

model Hardware {
  id                String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String
  manufacturer      String?
  type              HardwareType
  primaryPlatformId String?      @map("primary_platform_id") @db.Uuid
  primaryPlatform   Platform?    @relation(fields: [primaryPlatformId], references: [id])

  software            SoftwareHardware[]
  performanceRatings  PerformanceRating[]
  listEntries         UserListEntry[]
  platforms           HardwarePlatform[]

  @@index([primaryPlatformId])
  @@index([type])
  @@map("hardware")
}

model HardwarePlatform {
  hardwareId String @map("hardware_id") @db.Uuid
  platformId String @map("platform_id") @db.Uuid

  hardware Hardware @relation(fields: [hardwareId], references: [id])
  platform Platform @relation(fields: [platformId], references: [id])

  @@id([hardwareId, platformId])
  @@index([platformId])
  @@map("hardware_platforms")
}

model Tag {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name               String   @unique
  approved           Boolean  @default(false)
  submittedBy        String?  @map("submitted_by") @db.Uuid
  submittedByProfile Profile? @relation("tag_submitted_by", fields: [submittedBy], references: [id])
  reviewedBy         String?  @map("reviewed_by") @db.Uuid
  reviewedByProfile  Profile? @relation("tag_reviewed_by", fields: [reviewedBy], references: [id])
  createdAt          DateTime @default(now()) @map("created_at")

  software SoftwareTag[]

  @@index([approved])
  @@map("tags")
}

// Junction tables
model SoftwareSystem {
  softwareId String @map("software_id") @db.Uuid
  systemId   String @map("system_id") @db.Uuid

  software Software @relation(fields: [softwareId], references: [id])
  system   System   @relation(fields: [systemId], references: [id])

  @@id([softwareId, systemId])
  @@index([systemId])
  @@map("software_systems")
}

model SoftwarePlatform {
  softwareId String @map("software_id") @db.Uuid
  platformId String @map("platform_id") @db.Uuid

  software Software @relation(fields: [softwareId], references: [id])
  platform Platform @relation(fields: [platformId], references: [id])

  @@id([softwareId, platformId])
  @@index([platformId])
  @@map("software_platforms")
}

model SoftwareHardware {
  softwareId String @map("software_id") @db.Uuid
  hardwareId String @map("hardware_id") @db.Uuid

  software Software @relation(fields: [softwareId], references: [id])
  hardware Hardware @relation(fields: [hardwareId], references: [id])

  @@id([softwareId, hardwareId])
  @@index([hardwareId])
  @@map("software_hardware")
}

model SoftwareTag {
  softwareId String  @map("software_id") @db.Uuid
  tagId      String  @map("tag_id") @db.Uuid
  approved   Boolean @default(false)

  software Software @relation(fields: [softwareId], references: [id])
  tag      Tag      @relation(fields: [tagId], references: [id])

  @@id([softwareId, tagId])
  @@index([tagId, approved])
  @@map("software_tags")
}

model QualityRating {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  softwareId String   @map("software_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  score      Int
  comment    String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  software Software @relation(fields: [softwareId], references: [id])
  user     Profile  @relation(fields: [userId], references: [id])

  @@unique([softwareId, userId])
  @@index([softwareId, score])
  @@index([createdAt])
  @@map("quality_ratings")
}

model PerformanceRating {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  softwareId String   @map("software_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  hardwareId String   @map("hardware_id") @db.Uuid
  score      Int
  comment    String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  software Software @relation(fields: [softwareId], references: [id])
  user     Profile  @relation(fields: [userId], references: [id])
  hardware Hardware @relation(fields: [hardwareId], references: [id])

  @@unique([softwareId, userId, hardwareId])
  @@index([softwareId])
  @@index([hardwareId])
  @@index([createdAt])
  @@map("performance_ratings")
}

model Submission {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type        SubmissionType
  submittedBy String           @map("submitted_by") @db.Uuid
  status      SubmissionStatus @default(PENDING)
  payload     Json
  targetId    String?          @map("target_id") @db.Uuid
  reviewedBy  String?          @map("reviewed_by") @db.Uuid
  reviewedAt  DateTime?        @map("reviewed_at")
  createdAt   DateTime         @default(now()) @map("created_at")

  submitter Profile @relation(fields: [submittedBy], references: [id])

  @@index([status, type, createdAt])
  @@index([submittedBy, status])
  @@map("submissions")
}

model Report {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reporterId        String           @map("reporter_id") @db.Uuid
  targetType        ReportTargetType @map("target_type")
  targetId          String?          @map("target_id") @db.Uuid
  reportedUserId    String?          @map("reported_user_id") @db.Uuid
  credibilityWeight Float            @default(1.0) @map("credibility_weight")
  comment           String?
  status            ReportStatus     @default(PENDING)
  upheldAt          DateTime?        @map("upheld_at")
  reviewedBy        String?          @map("reviewed_by") @db.Uuid
  reviewedAt        DateTime?        @map("reviewed_at")
  createdAt         DateTime         @default(now()) @map("created_at")

  reporter   Profile  @relation("reports_reporter", fields: [reporterId], references: [id])
  targetUser Profile? @relation("reports_target", fields: [reportedUserId], references: [id])

  @@index([status, targetType, createdAt])
  @@index([reporterId])
  @@index([reportedUserId])
  @@map("reports")
}

model UserList {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId     String   @map("owner_id") @db.Uuid
  name        String
  description String?
  isPublic    Boolean  @default(false) @map("is_public")
  clonedFrom  String?  @map("cloned_from") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  owner          Profile         @relation("owned_lists", fields: [ownerId], references: [id], onDelete: Cascade)
  clonedFromList UserList?       @relation("list_clones", fields: [clonedFrom], references: [id], onDelete: SetNull)
  clones         UserList[]      @relation("list_clones")
  entries        UserListEntry[]
  saves          UserListSave[]

  @@index([isPublic, createdAt])
  @@index([ownerId, createdAt])
  @@map("UserList")
}

model UserListEntry {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  listId     String  @map("list_id") @db.Uuid
  softwareId String  @map("software_id") @db.Uuid
  hardwareId String? @map("hardware_id") @db.Uuid
  notes      String?
  sortOrder  Int     @default(0) @map("sort_order")

  list     UserList  @relation(fields: [listId], references: [id], onDelete: Cascade)
  software Software  @relation(fields: [softwareId], references: [id], onDelete: Cascade)
  hardware Hardware? @relation(fields: [hardwareId], references: [id], onDelete: SetNull)

  @@unique([listId, softwareId])
  @@index([listId, sortOrder])
  @@index([softwareId])
  @@index([hardwareId])
  @@map("UserListEntry")
}

model UserListSave {
  userId  String   @map("user_id") @db.Uuid
  listId  String   @map("list_id") @db.Uuid
  savedAt DateTime @default(now()) @map("saved_at")

  user Profile  @relation("saved_lists", fields: [userId], references: [id], onDelete: Cascade)
  list UserList @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@id([userId, listId])
  @@index([listId])
  @@map("UserListSave")
}
